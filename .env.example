# Generator model (the one that answers the customer)
GENERATOR_PROVIDER=gemini          # or "ollama"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Judge model (the one that scores DeepEval metrics) — MUST differ from generator
JUDGE_PROVIDER=ollama              # or "gemini", "groq"
OLLAMA_MODEL=llama3.1
GROQ_API_KEY=                      # free cloud alternative for the judge
